{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=GymAssistantDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "GymAssistant.Api",
    "Audience": "GymAssistant.Web",
    "AccessTokenLifetimeMinutes": 30
  },
  "RefreshToken": {
    "LifetimeDays": 7
  },
  "Frontend": {
    "Origin": "http://localhost:5173"
  }
}
